      "typeVersion": 1,
      "position": [
        900,
        520
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e57f6225-413e-575e-a0de-57969fdb9ef7",
              "name": "text",
              "value": "={{ '*Approved retention action #' + $('Webhook').first().json.body.action_id + '* for customer ' + $('Webhook').first().json.body.customer_ref + '\\n' + $('Webhook').first().json.body.proposed_change_text + '\\nModel risk ' + Math.round($('Webhook').first().json.body.risk.before * 100) + '% -> ' + Math.round($('Webhook').first().json.body.risk.after * 100) + '%' + ' (' + $('Webhook').first().json.body.labels.interpretation + ')\\nProposed by ' + $('Webhook').first().json.body.requested_by + ', approved by ' + $('Webhook').first().json.body.approved_by }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5ccbc203-c71b-5f7f-9ed3-cefeae0f1565",
      "name": "Build message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        900,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3fe2f474-322b-58d3-9b4f-472da5e59c99",
              "leftValue": "={{ $env.SLACK_WEBHOOK_URL }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
