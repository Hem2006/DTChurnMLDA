      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.data }}",
        "dataPropertyName": "computed",
        "secret": "={{ $env.N8N_SHARED_SECRET }}",
        "encoding": "hex"
      },
      "id": "7e9801f9-6f38-5149-9cb3-b60290112670",
      "name": "Compute signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ebb4e7fe-c330-582c-bccd-e2012c9980d2",
              "leftValue": "={{ 'sha256=' + $json.computed }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $('Webhook').first().json.headers['x-evergreen-signature'] }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f5b1b77a-f459-5a71-8785-e0c9c77457dd",
      "name": "Signature valid?",
