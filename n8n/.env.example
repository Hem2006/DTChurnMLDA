# Copy to .env (never commit .env).
# Shared by n8n and the Evergreen API: signs the webhook and authenticates n8n's report back.
N8N_SHARED_SECRET=change-me-to-a-long-random-string

# Where n8n reaches the Evergreen API (from inside Docker the host is host.docker.internal).
EVERGREEN_URL=http://host.docker.internal:8000
# Only if you set CHURN_API_KEY on the API:
EVERGREEN_API_KEY=

# Optional: a Slack "Incoming Webhook" URL. Without it the workflows still run and report back
# that they only recorded the action in n8n.
SLACK_WEBHOOK_URL=

GENERIC_TIMEZONE=UTC
